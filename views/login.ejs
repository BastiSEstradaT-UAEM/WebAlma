<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#064b31">
  <meta name="description" content="Acceso al sistema WebAlma: papelería del Centro Universitario UAEM Valle de Chalco.">
  <title>Ingresar · WebAlma | UAEM Valle de Chalco</title>
  <link rel="stylesheet" href="/public/panel.css">
</head>
<body class="login-page login-uaem">
  <div class="login-decor one" aria-hidden="true"></div>
  <div class="login-decor two" aria-hidden="true"></div>

  <div class="uaem-login-shell">
    <main class="login-card" aria-labelledby="login-title">
      <div class="login-brand">
        <div class="brand-mark" aria-hidden="true">W<span>.</span></div>
        <div>
          <div class="brand-name">WebAlma</div>
          <div class="brand-sub">PAPELERÍA UNIVERSITARIA</div>
          <div class="login-brand-line" aria-hidden="true"></div>
        </div>
      </div>

      <div class="login-content">
        <span class="eyebrow">ACCESO AL SISTEMA</span>
        <h1 id="login-title">Bienvenida de nuevo</h1>
        <p>Ingresa al panel para administrar el inventario y los pedidos del Centro Universitario UAEM Valle de Chalco.</p>

        <% if (error) { %>
          <div class="login-error" role="alert">Usuario o contraseña incorrectos. Vuelve a intentarlo.</div>
        <% } %>

        <form action="/login" method="post" class="stack-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="form-field">
            <label for="username">Usuario</label>
            <input id="username" name="username" type="text" autocomplete="username" required placeholder="Tu nombre de usuario" autofocus>
          </div>
          <div class="form-field">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Ingresa tu contraseña">
          </div>
          <button type="submit" class="btn btn-primary full">Entrar al panel <span aria-hidden="true">→</span></button>
        </form>
      </div>

      <footer class="login-footer">
        <span aria-hidden="true" class="uaem-footer-line"></span>
        WebAlma · Sistema de gestión universitaria · 2026
        <span aria-hidden="true" class="uaem-footer-line"></span>
      </footer>
    </main>

    <aside class="login-side" aria-label="Identidad universitaria y servicios de WebAlma">
      <div class="uaem-hexagons" aria-hidden="true"></div>
      <header class="uaem-institution">
        <img src="/public/escudo-uaem.webp" width="108" height="96" alt="Escudo de la Universidad Autónoma del Estado de México">
        <div class="uaem-institution-copy">
          <strong>Universidad Autónoma<br>del Estado de México</strong>
          <span>Centro Universitario UAEM<br>Valle de Chalco</span>
        </div>
      </header>

      <div class="uaem-side-content">
        <div class="uaem-mascot">
          <img src="/public/cuxi-papeleria.webp" width="300" height="426" alt="Cuxi, mascota de la comunidad universitaria, con libreta, útiles de papelería y pulgar arriba">
        </div>

        <div class="uaem-side-information">
          <div class="uaem-side-title">
            <h2>WebAlma</h2>
            <span class="uaem-yellow-tag">Papelería universitaria</span>
            <p>Centro Universitario UAEM<br>Valle de Chalco</p>
          </div>

          <div class="uaem-feature-list">
            <div class="uaem-feature"><span class="uaem-feature-icon" aria-hidden="true">▣</span><div><strong>Inventario</strong><small>Control de productos<br>de papelería</small></div></div>
            <div class="uaem-feature"><span class="uaem-feature-icon" aria-hidden="true">🛒</span><div><strong>Pedidos</strong><small>Atención y seguimiento<br>de solicitudes</small></div></div>
            <div class="uaem-feature"><span class="uaem-feature-icon" aria-hidden="true">▤</span><div><strong>Papelería</strong><small>Material y suministros<br>para la comunidad</small></div></div>
          </div>
          <p class="uaem-side-slogan">Servicio de papelería<br>para nuestra comunidad<br>universitaria.</p>
        </div>
      </div>
      <div class="uaem-side-wave" aria-hidden="true"></div>
    </aside>
  </div>
</body>
</html>