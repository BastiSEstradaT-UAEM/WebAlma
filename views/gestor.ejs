<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#075338">
  <title>Papelería Universitaria · CU UAEM Valle de Chalco | WebAlma</title>
  <link rel="stylesheet" href="/public/panel.css">
  <link rel="stylesheet" href="/public/panel-uaem-v1.css?v=1">
  <script src="/socket.io/socket.io.js" defer></script>
  <script src="/public/panel.js" defer></script>
</head>
<body data-initial-section="<%= seccion || 'resumen' %>">
  <svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="M3 7v10l9 5 9-5V7M12 12v10"/></symbol>
    <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 10h18c0-2-3-3-3-10ZM10 22h4"/></symbol>
    <symbol id="i-print" viewBox="0 0 24 24"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 15h12v7H6zM18 12h.01"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 19V5M4 19h17M8 15v-4M13 15V7M18 15V9"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="m19 12 2-1-1-4-2 0-2-2-1-2h-5l-1 2-2 2-2 0-1 4 2 1-2 2 1 4 2 0 2 2 1 2h5l1-2 2-2 2 0 1-4-2-2Z"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24"><path d="m4 20 4-.9L20 7a2.1 2.1 0 0 0-3-3L5 16l-1 4ZM14 7l3 3"/></symbol>
    <symbol id="i-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="m12 3 10 18H2L12 3ZM12 9v5M12 18h.01"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M14 7l5 5-5 5M19 12H9"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5 5 19"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M5 2h9l5 5v15H5V2ZM14 2v5h5M8 12h8M8 16h8"/></symbol>
  </svg>
  <% const fmx = n => '$' + Number(n || 0).toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2}); %>
  <% const categorias = [...new Set(inventario.map(p => p.categoria || 'Otros'))].sort((a,b) => a.localeCompare(b,'es')); %>

  <div class="layout">
    <aside class="sidebar" id="sidebar">
      <div class="brand-wrap">
        <div class="brand-mark">W<span>.</span></div>
        <div><div class="brand-name">WebAlma</div><div class="brand-sub">PAPELERÍA UNIVERSITARIA</div></div>
        <button type="button" class="icon-button mobile-close" id="closeSidebar" aria-label="Cerrar menú"><svg class="ico"><use href="#i-x"/></svg></button>
      </div>
      <div class="side-label">ESPACIO DE TRABAJO</div>
      <nav class="nav" aria-label="Navegación principal">
        <button type="button" data-nav="resumen" class="nav-item active"><svg class="ico"><use href="#i-grid"/></svg><span>Vista general</span></button>
        <button type="button" data-nav="inventario" class="nav-item"><svg class="ico"><use href="#i-box"/></svg><span>Inventario</span><span class="nav-count"><%= inventario.length %></span></button>
        <button type="button" data-nav="pedidos" class="nav-item"><svg class="ico"><use href="#i-bell"/></svg><span>Pedidos de Telegram</span><span class="nav-count" id="navOrderCount"><%= pedidosActivos.length %></span></button>
        <button type="button" data-nav="impresiones" class="nav-item"><svg class="ico"><use href="#i-print"/></svg><span>Copias e impresiones</span></button>
        <button type="button" data-nav="reportes" class="nav-item"><svg class="ico"><use href="#i-chart"/></svg><span>Reportes</span></button>
      </nav>
      <div class="side-label side-label-second">ADMINISTRACIÓN</div>
      <nav class="nav"><button type="button" data-nav="configuracion" class="nav-item"><svg class="ico"><use href="#i-settings"/></svg><span>Configuración</span></button></nav>
      <div class="side-bottom">
        <div class="campus-chip"><img class="campus-seal" src="/public/escudo-uaem.webp" width="41" height="42" alt=""><div><strong>Papelería universitaria</strong><small>CU UAEM Valle de Chalco</small></div></div>
        <div class="side-profile"><div class="avatar"><%= usuario.rol === 'administradora' ? 'A' : 'X' %></div><div class="profile-name"><strong><%= usuario.nombre %></strong><small><%= usuario.rol === 'administradora' ? 'Cuenta propietaria' : 'Personal auxiliar' %></small></div>
          <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="logout-button" aria-label="Cerrar sesión" title="Cerrar sesión"><svg class="ico"><use href="#i-logout"/></svg></button></form>
        </div>
      </div>
    </aside>

    <div class="workspace">
      <header class="topbar">
        <div class="topbar-left"><button class="icon-button hamburger" id="openSidebar" type="button" aria-label="Abrir menú"><svg class="ico"><use href="#i-menu"/></svg></button><span class="breadcrumb">Papelería UAEM · Valle de Chalco</span><span class="breadcrumb-sep">/</span><span id="currentViewName">Vista general</span></div>
        <div class="topbar-right"><span class="live-state"><span class="live-dot"></span> Conectado a PostgreSQL</span><span class="topbar-divider"></span><span class="topbar-date" id="todayDate"></span><div class="top-avatar"><%= usuario.rol === 'administradora' ? 'A' : 'X' %></div></div>
      </header>
      <main class="content">
        <div class="notice-bar" role="note"><svg class="ico"><use href="#i-alert"/></svg><span><strong>Datos en validación:</strong> gran parte de los precios y existencias son de prueba. Confirmen los datos físicos con la propietaria antes de usarlos para ventas reales.</span><button type="button" class="notice-dismiss" aria-label="Ocultar aviso" onclick="this.parentElement.remove()">×</button></div>
        <% if (resultado) { %><div class="flash" data-flash="<%= resultado %>" role="status"></div><% } %>

        <section class="view" id="view-resumen" data-view="resumen">
          <div class="page-intro"><div><div class="eyebrow">PAPELERÍA UNIVERSITARIA</div><h1>Bienvenida a la papelería <span class="wave">✦</span></h1><p>Control de productos, pedidos e impresiones desde un solo lugar.</p><span class="uaem-identity">Centro Universitario UAEM Valle de Chalco</span></div><button class="btn btn-primary" type="button" data-go="inventario"><svg class="ico"><use href="#i-box"/></svg> Administrar inventario</button></div>
          <div class="metric-grid">
            <article class="metric-card"><div class="metric-top"><span>Productos registrados</span><span class="metric-symbol symbol-blue"><svg class="ico"><use href="#i-box"/></svg></span></div><strong class="metric-number"><%= inventario.length.toLocaleString('es-MX') %></strong><div class="metric-foot">En PostgreSQL</div></article>
            <article class="metric-card"><div class="metric-top"><span>Pedidos en gestión</span><span class="metric-symbol symbol-orange"><svg class="ico"><use href="#i-bell"/></svg></span></div><strong class="metric-number" id="metricPending"><%= pedidosActivos.length %></strong><div class="metric-foot"><span class="badge badge-orange">Telegram</span> Actualización en vivo</div></article>
            <article class="metric-card"><div class="metric-top"><span>Stock por revisar</span><span class="metric-symbol symbol-red"><svg class="ico"><use href="#i-alert"/></svg></span></div><strong class="metric-number"><%= lowStock.length %></strong><div class="metric-foot">Artículos en o bajo el mínimo</div></article>
            <article class="metric-card"><div class="metric-top"><span>Impresiones esta semana</span><span class="metric-symbol symbol-green"><svg class="ico"><use href="#i-print"/></svg></span></div><strong class="metric-number"><%= report.bn.hojas + report.color.hojas %></strong><div class="metric-foot">Hojas registradas en el panel</div></article>
          </div>
          <div class="dashboard-grid">
            <article class="panel"><div class="panel-head"><div><h2>Pedidos recientes</h2><p>Solicitudes recibidas desde Telegram</p></div><button class="subtle-link" type="button" data-go="pedidos">Ver todos <svg class="ico"><use href="#i-arrow"/></svg></button></div><div id="homeOrders">
            <% if (pedidosActivos.length === 0) { %><div class="empty-state compact"><div class="empty-icon"><svg class="ico"><use href="#i-check"/></svg></div><strong>¡Todo al día!</strong><p>No tienes pedidos pendientes por atender.</p></div><% } else { %>
              <% pedidosActivos.slice(-3).reverse().forEach(p => { %><div class="summary-order"><div class="mini-avatar"><%= String(p.cliente || 'E').slice(0,1).toUpperCase() %></div><div class="summary-body"><strong><%= p.cliente %></strong><span><%= Array.isArray(p.articulos) ? p.articulos.length : 0 %> artículo(s) · <%= p.hora || '—' %></span></div><strong><%= fmx(p.total) %></strong></div><% }); %>
            <% } %></div></article>
            <article class="panel"><div class="panel-head"><div><h2>Atención de inventario</h2><p>Productos que requieren revisión o reposición</p></div><button class="subtle-link" type="button" data-go="inventario">Abrir <svg class="ico"><use href="#i-arrow"/></svg></button></div><div class="stock-preview">
              <% if (!lowStock.length) { %><div class="empty-state compact"><strong>Sin alertas de stock</strong><p>No hay artículos por debajo de su mínimo.</p></div><% } %>
              <% lowStock.slice(0,5).forEach(p => { %><div class="stock-line"><span class="stock-name"><%= p.producto %></span><div class="stock-line-right"><strong><%= p.stock %> uds.</strong><span class="badge <%= p.stock === 0 ? 'badge-red' : 'badge-orange' %>"><%= p.stock === 0 ? 'Sin stock' : 'Bajo' %></span></div></div><% }); %>
            </div></article>
          </div>
          <div class="insight-strip"><div class="insight-icon"><svg class="ico"><use href="#i-clock"/></svg></div><div><strong>Aviso del establecimiento</strong><p><%= config.aviso || 'Todavía no hay avisos de apertura o cierre extraordinario.' %></p></div><button type="button" class="btn btn-quiet" data-go="configuracion">Ver configuración</button></div>
        </section>

        <section class="view" id="view-inventario" data-view="inventario" hidden>
          <div class="page-intro"><div><div class="eyebrow">CONTROL DE PRODUCTOS</div><h1>Inventario general</h1><p>Consulta, filtra y actualiza los artículos de la papelería.</p></div><% if (usuario.rol === 'administradora') { %><button type="button" class="btn btn-primary" id="newProductBtn"><svg class="ico"><use href="#i-plus"/></svg> Nuevo producto</button><% } %></div>
          <div class="section-card inventory-card">
            <div class="inventory-toolbar"><label class="search-field"><svg class="ico"><use href="#i-search"/></svg><input id="inventorySearch" type="search" placeholder="Buscar por nombre, ID o categoría..." autocomplete="off"></label><select id="categoryFilter" aria-label="Filtrar por categoría"><option value="">Todas las categorías</option><% categorias.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select><select id="stockFilter" aria-label="Filtrar por stock"><option value="">Todas las existencias</option><option value="low">Stock bajo</option><option value="empty">Sin existencias</option><option value="unverified">Por validar</option></select></div>
            <div class="table-scroll"><table class="data-table" id="inventoryTable"><thead><tr><th>ID</th><th>Producto / categoría</th><th>Precio</th><th>Disponibilidad</th><th>Estado</th><th class="align-right">Acciones</th></tr></thead><tbody>
              <% inventario.forEach(p => { const min = p.stock_minimo_sugerido == null ? config.stockMinimo : Number(p.stock_minimo_sugerido); const isLow = Number(p.stock) <= min; const verified = p.existencia_confirmada === true && p.precio_confirmado === true; %>
              <tr data-product-row data-search="<%= (p.id+' '+p.producto+' '+(p.categoria||'')).toLowerCase() %>" data-category="<%= p.categoria %>" data-low="<%= isLow %>" data-empty="<%= Number(p.stock) === 0 %>" data-unverified="<%= !verified %>">
                <td class="cell-id">#<%= p.id %></td><td><strong class="product-title"><%= p.producto %></strong><span class="product-category"><%= p.categoria || 'Otros' %></span></td>
                <td class="price-cell"><%= fmx(p.precio) %></td>
                <td><span class="stock-pill <%= Number(p.stock) === 0 ? 'stock-zero' : isLow ? 'stock-low' : 'stock-good' %>"><span class="pill-dot"></span><%= p.stock %> uds.</span></td>
                <td><span class="badge <%= verified ? 'badge-green' : 'badge-muted' %>"><%= verified ? 'Verificado' : 'Por validar' %></span></td>
                <td class="align-right actions-cell"><% if (usuario.rol === 'administradora') { %><button type="button" class="table-action movement-btn" title="Registrar entrada o salida" data-id="<%= p.id %>" data-name="<%= p.producto %>" data-stock="<%= p.stock %>"><svg class="ico"><use href="#i-box"/></svg><span>Movimiento</span></button><button type="button" class="table-action edit-btn" title="Editar producto" data-id="<%= p.id %>" data-name="<%= p.producto %>" data-category="<%= p.categoria %>" data-price="<%= p.precio %>" data-minimum="<%= min %>" data-existence="<%= p.existencia_confirmada === true %>" data-price-verified="<%= p.precio_confirmado === true %>"><svg class="ico"><use href="#i-edit"/></svg><span>Editar</span></button><% } %></td>
              </tr><% }); %>
            </tbody></table></div>
            <div class="table-footer"><span id="inventoryCounter">Mostrando <%= inventario.length %> de <%= inventario.length %> productos</span><span>Precios en MXN · Los movimientos se registran por lote PEPS</span></div>
          </div>
        </section>

        <section class="view" id="view-pedidos" data-view="pedidos" hidden>
          <div class="page-intro"><div><div class="eyebrow">ATENCIÓN EN TIEMPO REAL</div><h1>Pedidos de Telegram</h1><p>Los pedidos nuevos aparecen automáticamente, sin recargar la página.</p></div><span class="connection-pill"><span class="live-dot"></span><span id="socketStatus">Conectando...</span></span></div>
          <div class="section-card orders-panel"><div class="panel-head"><div><h2>Pedidos por revisar y entregar</h2><p>Acepta o rechaza nuevas solicitudes; marca como entregados los pedidos aceptados.</p></div><span class="badge badge-orange" id="ordersCounter"><%= pedidosActivos.length %> en gestión</span></div>
          <div class="orders-list" id="ordersList">
            <% if (!pedidosActivos.length) { %><div class="empty-state" id="ordersEmpty"><div class="empty-icon"><svg class="ico"><use href="#i-bell"/></svg></div><strong>No hay pedidos por atender</strong><p>Cuando alguien confirme desde Telegram, aparecerá aquí.</p></div><% } %>
            <% pedidosActivos.slice().reverse().forEach(p => { %>
              <article class="order-card" data-order-id="<%= p.id %>">
                <div class="order-head">
                  <div class="order-customer">
                    <div class="mini-avatar"><%= String(p.cliente || 'E').slice(0,1).toUpperCase() %></div>
                    <div><strong><%= p.cliente %></strong><small><svg class="ico"><use href="#i-clock"/></svg> <%= p.hora || '—' %> · Folio <%= p.id %></small></div>
                  </div>
                  <span class="badge order-state-badge <%= p.estado==='aceptado'?'badge-green':'badge-orange' %>"><%= p.estado==='aceptado'?'Aceptado':'Por aceptar' %></span>
                </div>
                <div class="order-items">
                  <% (Array.isArray(p.articulos) ? p.articulos : []).forEach(a => { %><div>• <%= a %></div><% }); %>
                </div>
                <% if(Array.isArray(p.documentos) && p.documentos.length){ %>
                  <div class="order-items order-documents">
                    <strong>Documentos enviados por Telegram:</strong>
                    <% p.documentos.forEach(doc=>{ %>
                      <div><a href="/pedidos/<%= encodeURIComponent(p.id) %>/archivos/<%= encodeURIComponent(doc.id) %>/descargar">📄 Descargar PDF: <%= doc.nombre %></a></div>
                    <% }) %>
                  </div>
                <% } %>
                <div class="order-bottom">
                  <div><small>Total cotizado</small><strong><%= fmx(p.total) %></strong></div>
                  <div class="order-actions">
                    <% if(p.estado==='aceptado'){ %>
                      <form method="post" action="/completar_pedido/<%= encodeURIComponent(p.id) %>">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <button type="submit" class="btn btn-success">✓ Marcar entregado</button>
                      </form>
                    <% } else { %>
                      <form method="post" action="/pedidos/<%= encodeURIComponent(p.id) %>/aceptar">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <button type="submit" class="btn btn-success">✓ Aceptar pedido</button>
                      </form>
                      <form method="post" action="/pedidos/<%= encodeURIComponent(p.id) %>/rechazar" data-confirm="¿Rechazar el pedido #<%= p.id %>? El estudiante recibirá una notificación.">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <button type="submit" class="btn btn-reject">✕ Rechazar pedido</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }); %>
          </div></div><p class="helper-below">Marcar un pedido como entregado no descuenta automáticamente inventario: el bot actual envía descripciones, no identificadores estructurados de productos.</p>
        </section>

        <section class="view" id="view-impresiones" data-view="impresiones" hidden>
          <div class="page-intro"><div><div class="eyebrow">SERVICIOS DE PAPELERÍA</div><h1>Copias e impresiones</h1><p>Registra los servicios terminados para obtener el corte semanal.</p></div><span class="badge badge-muted">Registro manual de mostrador</span></div>
          <div class="two-column">
            <article class="section-card pad-card"><div class="panel-head"><div><h2>Registrar servicio</h2><p>El costo se calcula a partir del precio configurado.</p></div><span class="round-icon"><svg class="ico"><use href="#i-print"/></svg></span></div><form action="/impresiones/registrar" method="post" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-field"><label for="printType">Tipo de impresión</label><select name="tipo" id="printType" required><option value="bn">Blanco y negro · <%= fmx(config.precioBN) %> / hoja</option><option value="color">A color · <%= fmx(config.precioColor) %> / hoja</option></select></div><div class="form-field"><label for="printQuantity">Cantidad de hojas</label><input name="cantidad" id="printQuantity" type="number" min="1" max="50000" value="1" required></div><div class="form-field"><label for="printNote">Referencia (opcional)</label><input name="observacion" id="printNote" maxlength="150" placeholder="Ej.: impresión de tesis"></div><div class="estimate-box"><span>Total del servicio</span><strong id="estimatedPrintTotal"><%= fmx(config.precioBN) %></strong></div><button class="btn btn-primary full" type="submit">Registrar impresión</button><p class="hint">Registra únicamente servicios realizados; no se descuentan tintas ni papel automáticamente.</p></form></article>
            <article class="section-card pad-card"><div class="panel-head"><div><h2>Actividad reciente</h2><p>Últimos servicios capturados</p></div></div>
            <% if (!recientes.length) { %><div class="empty-state compact"><div class="empty-icon"><svg class="ico"><use href="#i-file"/></svg></div><strong>Sin registros todavía</strong><p>El historial comenzará con el primer servicio.</p></div><% } else { %><div class="recent-list"><% recientes.forEach(r => { %><div class="recent-row"><span class="round-icon small"><svg class="ico"><use href="#i-print"/></svg></span><div><strong><%= r.cantidad %> hojas · <%= r.tipo === 'color' ? 'Color' : 'Blanco y negro' %></strong><small><%= r.fecha %> <%= r.observacion ? '· ' + r.observacion : '' %></small></div><strong><%= fmx(r.total) %></strong></div><% }); %></div><% } %></article>
          </div>
        </section>

        <section class="view" id="view-reportes" data-view="reportes" hidden>
          <div class="page-intro">
            <div>
              <div class="eyebrow">ACTIVIDAD DE LA PAPELERÍA</div>
              <h1>Reportes y seguimiento</h1>
              <p>Pedidos de Telegram, documentos PDF y servicios de impresión guardados en PostgreSQL.</p>
            </div>
            <button class="btn btn-quiet" id="refreshReports" type="button" aria-label="Actualizar datos del reporte">
              <svg class="ico"><use href="#i-chart"/></svg> Actualizar reportes
            </button>
          </div>

          <div class="report-period"><svg class="ico"><use href="#i-clock"/></svg>
            Actividad semanal: <strong><%= bounds.start %></strong> al <strong><%= bounds.end %></strong> · Zona horaria de México
          </div>
          <div class="report-kpi-grid" aria-label="Indicadores históricos y semanales de pedidos">
            <article class="report-kpi">
              <span class="report-kpi-label">Pedidos registrados</span>
              <strong><%= reporteActividad.allCount %></strong>
              <small>Histórico · incluye pedidos ya cerrados</small>
            </article>
            <article class="report-kpi">
              <span class="report-kpi-label">Pedidos esta semana</span>
              <strong><%= reporteActividad.weeklyCount %></strong>
              <small>Cotizaciones: <%= fmx(reporteActividad.weeklyQuoted) %></small>
            </article>
            <article class="report-kpi">
              <span class="report-kpi-label">Archivos PDF registrados</span>
              <strong><%= reporteActividad.totalPdf %></strong>
              <small>En <%= reporteActividad.ordersWithPdf %> pedido(s)</small>
            </article>
            <article class="report-kpi">
              <span class="report-kpi-label">Importe total cotizado</span>
              <strong class="report-kpi-money"><%= fmx(reporteActividad.allCotizado) %></strong>
              <small>Cotizaciones históricas · no pagos recibidos</small>
            </article>
          </div>
          <p class="report-disclaimer"><svg class="ico"><use href="#i-alert"/></svg>
            Los pedidos registrados pueden incluir pruebas del desarrollo. No hay una marca que permita distinguir todas las pruebas de los pedidos reales. Las cotizaciones NO son ventas cobradas ni ingresos confirmados.
          </p>

          <div class="report-visual-grid">
            <article class="section-card report-visual-card">
              <div class="panel-head"><div>
                <h2>Pedidos de la semana</h2>
                <p>Cantidad por día, incluyendo pendientes, aceptados, entregados y rechazados</p>
              </div><span class="badge badge-green"><%= reporteActividad.weeklyCount %> pedidos</span></div>
              <div class="report-bars" role="img" aria-label="Gráfica de pedidos registrados por día de la semana">
                <% reporteActividad.days.forEach(d=>{ %>
                  <div class="report-day-column" title="<%= d.date %>: <%= d.total %> pedidos">
                    <span class="report-bar-value"><%= d.total %></span>
                    <div class="report-bar-slot">
                      <div class="report-bar-fill <%= d.total ? '' : 'is-zero' %>" style="--bar-height:<%= d.height %>%"></div>
                    </div>
                    <span class="report-day-label"><%= d.label %></span>
                    <span class="report-day-date"><%= d.day %></span>
                  </div>
                <% }) %>
              </div>
              <p class="report-chart-note">Los días sin pedidos aparecen con valor cero. Solo se incluyen los registros de PostgreSQL.</p>
            </article>
            <article class="section-card report-visual-card">
              <div class="panel-head"><div><h2>Estado de los pedidos</h2><p>Distribución histórica de todas las solicitudes</p></div></div>
              <div class="report-state-chart" role="img" aria-label="Gráfica horizontal de pedidos por estado">
                <% reporteActividad.states.forEach(s=>{ %>
                  <div class="report-state-item">
                    <div class="report-state-heading">
                      <span><i class="report-state-dot report-state-<%= s.className %>"></i><%= s.label %></span>
                      <strong><%= s.count %> <small>(<%= s.percent %>%)</small></strong>
                    </div>
                    <div class="report-state-track">
                      <div class="report-state-fill report-state-<%= s.className %>" style="--state-width:<%= s.percent %>%"></div>
                    </div>
                  </div>
                <% }) %>
              </div>
              <p class="report-chart-note">Un pedido entregado no acredita por sí mismo el pago. Rechazados y cancelados también permanecen en el histórico.</p>
            </article>
          </div>

          <article class="section-card report-history">
            <div class="panel-head">
              <div><h2>Historial de pedidos y pruebas</h2><p>Hasta 150 registros recientes; se conservan incluso después de atenderlos.</p></div>
              <span class="badge badge-green" id="reportVisibleCount"><%= reporteActividad.recent.length %> visibles</span>
            </div>
            <div class="report-history-filters">
              <div class="form-field"><label for="reportDateFilter">Filtrar por fecha</label><input id="reportDateFilter" type="date" max="<%= reporteActividad.today %>"></div>
              <div class="form-field"><label for="reportStatusFilter">Estado del pedido</label>
                <select id="reportStatusFilter">
                  <option value="">Todos los estados</option>
                  <% reporteActividad.states.forEach(s=>{ %><option value="<%= s.key %>"><%= s.label %></option><% }) %>
                </select>
              </div>
              <button id="reportToday" type="button" class="btn btn-primary">Ver pruebas de hoy</button>
              <button id="reportClear" type="button" class="btn btn-quiet">Ver todos</button>
            </div>
            <div class="table-scroll">
              <table class="data-table report-history-table">
                <thead><tr><th>Folio</th><th>Fecha y hora (México)</th><th>Estado</th><th>Artículos</th><th>PDF</th><th>Importe cotizado</th></tr></thead>
                <tbody id="reportHistoryBody">
                  <% reporteActividad.recent.forEach(p=>{ %>
                    <tr data-report-date="<%= p.date %>" data-report-status="<%= p.estado %>">
                      <td class="cell-id">#<%= p.id %></td>
                      <td><%= p.date %> · <%= p.time %></td>
                      <td><span class="report-status-badge report-status-<%= p.statusClass %>"><%= p.statusLabel %></span></td>
                      <td><%= p.items %></td><td><%= p.pdf %></td><td class="price-cell"><%= fmx(p.total) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="empty-state compact" id="reportNoMatches" hidden><strong>Sin registros con estos filtros</strong><p>Cambia la fecha o el estado para consultar otras solicitudes.</p></div>
            </div>
            <div class="table-footer"><span>Las fechas se muestran en horario del centro de México.</span><span>Por privacidad, no se muestran nombres ni cuentas de estudiantes.</span></div>
          </article>

          <div class="report-section-divider"><span>Servicios de impresión registrados en mostrador</span></div>
          <div class="page-intro report-subheading">
            <div><h2>Resumen de impresiones</h2><p>Solo considera servicios registrados manualmente como terminados; las cotizaciones PDF no se suman aquí.</p></div>
            <a class="btn btn-primary" href="/reportes/semanal.csv"><svg class="ico"><use href="#i-file"/></svg> Exportar CSV semanal</a>
          </div>
          <div class="metric-grid report-stats">
            <article class="metric-card"><div class="metric-top">Hojas blanco y negro</div><strong class="metric-number"><%= report.bn.hojas %></strong><div class="metric-foot"><%= report.bn.trabajos %> trabajos</div></article>
            <article class="metric-card"><div class="metric-top">Hojas a color</div><strong class="metric-number"><%= report.color.hojas %></strong><div class="metric-foot"><%= report.color.trabajos %> trabajos</div></article>
            <article class="metric-card"><div class="metric-top">Importe registrado B/N</div><strong class="metric-number money-stat"><%= fmx(report.bn.ingresos) %></strong><div class="metric-foot">No confirma cobro</div></article>
            <article class="metric-card"><div class="metric-top">Importe registrado color</div><strong class="metric-number money-stat"><%= fmx(report.color.ingresos) %></strong><div class="metric-foot">No confirma cobro</div></article>
          </div>
          <article class="section-card pad-card">
            <div class="panel-head"><div><h2>Desglose semanal de impresión</h2><p>Servicios registrados manualmente durante la semana indicada.</p></div><span class="badge badge-green">Importe registrado <%= fmx(report.total) %></span></div>
            <div class="table-scroll"><table class="data-table report-table">
              <thead><tr><th>Servicio</th><th>Trabajos</th><th>Hojas</th><th>Importe registrado</th></tr></thead>
              <tbody><tr><td>Blanco y negro</td><td><%= report.bn.trabajos %></td><td><%= report.bn.hojas %></td><td><strong><%= fmx(report.bn.ingresos) %></strong></td></tr><tr><td>A color</td><td><%= report.color.trabajos %></td><td><%= report.color.hojas %></td><td><strong><%= fmx(report.color.ingresos) %></strong></td></tr><tr class="total-row"><td>Total</td><td><%= report.bn.trabajos + report.color.trabajos %></td><td><%= report.bn.hojas + report.color.hojas %></td><td><%= fmx(report.total) %></td></tr></tbody>
            </table></div>
          </article>
          <article class="section-card pad-card report-monthly">
            <div class="panel-head"><div><h2>Corte mensual</h2><p>Exporta los servicios de impresión registrados para un mes.</p></div></div>
            <form action="/reportes/mensual.csv" method="get" class="form-row" style="align-items:end">
              <div class="form-field"><label for="reportMonth">Mes</label><input id="reportMonth" name="mes" type="month" required value="<%= reporteActividad.today.slice(0,7) %>"></div>
              <button class="btn btn-primary" type="submit">Descargar CSV mensual</button>
            </form>
          </article>
          <p class="helper-below">El importe registrado por impresión tampoco demuestra el cobro o la utilidad neta. Para calcular ganancias se requieren comprobantes de pago y costos reales de tinta, papel y operación.</p>
        </section>

        <section class="view" id="view-configuracion" data-view="configuracion" hidden>
          <div class="page-intro"><div><div class="eyebrow">CONFIGURACIÓN DE LA PAPELERÍA</div><h1>Configuración</h1><p>Datos operativos y valores que deben validarse con la papelería.</p></div></div>
          <div class="two-column settings-layout"><article class="section-card pad-card"><div class="panel-head"><div><h2>Datos de la papelería</h2><p>Los cambios se guardan en PostgreSQL y son compartidos con Telegram.</p></div></div>
          <% if (usuario.rol === 'administradora') { %>
          <form method="post" action="/configuracion/guardar" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-field"><label for="openingHours">Horario comunicado al público</label><input id="openingHours" name="horario" maxlength="100" value="<%= config.horario %>"></div><div class="form-field"><label for="announcement">Aviso especial de apertura o cierre</label><textarea name="aviso" id="announcement" rows="3" maxlength="350" placeholder="Ej.: El lunes abriremos a las 8:30 a. m."><%= config.aviso %></textarea></div><div class="form-row"><div class="form-field"><label for="priceBlack">Precio B/N</label><input type="number" min="0" step="0.01" id="priceBlack" name="precioBN" value="<%= config.precioBN %>" required></div><div class="form-field"><label for="priceColor">Precio color</label><input type="number" min="0" step="0.01" id="priceColor" name="precioColor" value="<%= config.precioColor %>" required></div></div><div class="form-field"><label for="lowThreshold">Mínimo general de existencias</label><input type="number" min="0" step="1" id="lowThreshold" name="stockMinimo" value="<%= config.stockMinimo %>" required></div><label class="checkbox-line"><input type="checkbox" name="preciosValidados" value="si" <%= config.preciosValidados ? 'checked' : '' %>> Estos precios fueron confirmados por la propietaria</label><button class="btn btn-primary full" type="submit">Guardar configuración</button></form>
          <% } else { %><p class="hint">Solo la propietaria puede modificar los precios y la configuración del negocio.</p><dl class="readonly-values"><dt>Horario</dt><dd><%= config.horario %></dd><dt>Aviso</dt><dd><%= config.aviso || 'Ninguno' %></dd></dl><% } %></article>
          <article class="section-card pad-card"><div class="panel-head"><div><h2>Acerca del sistema WebAlma</h2><p>Alcance actual y tareas pendientes</p></div></div><div class="feature-status"><div><span class="status-icon ok"><svg class="ico"><use href="#i-check"/></svg></span><span>Inventario conectado al bot de Telegram</span></div><div><span class="status-icon ok"><svg class="ico"><use href="#i-check"/></svg></span><span>Pedidos instantáneos con Socket.io</span></div><div><span class="status-icon ok"><svg class="ico"><use href="#i-check"/></svg></span><span>Registro de entradas y salidas PEPS</span></div><div><span class="status-icon progress"><svg class="ico"><use href="#i-clock"/></svg></span><span>Verificar existencias y precios físicos</span></div><div><span class="status-icon progress"><svg class="ico"><use href="#i-clock"/></svg></span><span>Recepción de archivos por Telegram y pagos verificados</span></div><div><span class="status-icon progress"><svg class="ico"><use href="#i-clock"/></svg></span><span>Sincronizar los precios y avisos de configuración con el bot</span></div></div><p class="hint">La auxiliar puede registrar impresiones y entregas; solo la propietaria puede agregar productos, cambiar precios o modificar existencias.</p></article></div>
        </section>
      </main>
    </div>
  </div>

  <div class="modal-backdrop" id="productModal" hidden><div class="modal" role="dialog" aria-modal="true" aria-labelledby="productModalTitle"><div class="modal-head"><div><h2 id="productModalTitle">Nuevo producto</h2><p>Registra los datos del artículo.</p></div><button type="button" class="icon-button close-modal" aria-label="Cerrar"><svg class="ico"><use href="#i-x"/></svg></button></div><form method="post" action="/inventario/nuevo" id="productForm" class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-field"><label>Nombre del producto</label><input type="text" name="producto" id="formProductName" maxlength="150" required placeholder="Ej.: Cuaderno profesional raya 100 hojas"></div><div class="form-field"><label>Categoría</label><input type="text" name="categoria" id="formCategory" maxlength="80" list="categories" required placeholder="Ej.: Cuadernos"><datalist id="categories"><% categorias.forEach(c => { %><option value="<%= c %>"></option><% }) %></datalist></div><div class="form-row"><div class="form-field"><label>Precio de venta (MXN)</label><input type="number" name="precio" id="formPrice" step="0.01" min="0" required></div><div class="form-field" id="initialStockField"><label>Existencias iniciales</label><input type="number" name="stock" id="formStock" min="0" step="1" value="0" required></div><div class="form-field"><label>Stock mínimo</label><input type="number" name="minimo" id="formMin" min="0" step="1" value="10" required></div></div><div class="validation-checks"><label class="checkbox-line"><input type="checkbox" name="existencia_confirmada" id="formExistence" value="si"> Existencias verificadas físicamente</label><label class="checkbox-line"><input type="checkbox" name="precio_confirmado" id="formPriceVerified" value="si"> Precio confirmado con propietaria</label></div><div class="modal-footer"><button type="button" class="btn btn-quiet close-modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar producto</button></div></form></div></div>

  <div class="modal-backdrop" id="movementModal" hidden><div class="modal" role="dialog" aria-modal="true" aria-labelledby="movementTitle"><div class="modal-head"><div><h2 id="movementTitle">Movimiento de stock</h2><p id="movementProductName">Producto</p></div><button type="button" class="icon-button close-modal" aria-label="Cerrar"><svg class="ico"><use href="#i-x"/></svg></button></div><form method="post" id="movementForm" class="modal-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-field"><label>Tipo de movimiento</label><select name="tipo"><option value="entrada">Entrada · nueva mercancía</option><option value="salida">Salida · venta, merma o ajuste</option></select></div><div class="form-field"><label>Cantidad</label><input name="cantidad" type="number" min="1" step="1" value="1" required></div><div class="form-field"><label>Nota (opcional)</label><input name="nota" maxlength="180" placeholder="Ej.: reposición proveedor"></div><p class="hint">Las salidas descuentan unidades del lote más antiguo disponible (PEPS). Las existencias iniciales se consideran un lote sin fecha verificada.</p><div class="modal-footer"><button type="button" class="btn btn-quiet close-modal">Cancelar</button><button type="submit" class="btn btn-primary">Registrar movimiento</button></div></form></div></div>

  <div class="toast-region" id="toasts" aria-live="polite"></div>
  <script>window.WEBALMA_PANEL = { csrf: <%- JSON.stringify(csrf) %>, totalInventario: <%= inventario.length %>, precioBN: <%= Number(config.precioBN) %>, precioColor: <%= Number(config.precioColor) %> };</script>
</body>
</html>
